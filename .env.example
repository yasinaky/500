# Copy to .env and fill in. NEVER commit the real .env.

# HTTP server
PORT=8080

# Supabase Postgres connection string (Project Settings -> Database -> Connection string).
# Example: postgres://postgres:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# Supabase JWT secret (Project Settings -> API -> JWT Settings -> JWT Secret).
# The backend verifies Supabase-issued access tokens with this (HS256).
SUPABASE_JWT_SECRET=

# Optional: the audience claim Supabase sets on access tokens (default is "authenticated").
SUPABASE_JWT_AUD=authenticated
